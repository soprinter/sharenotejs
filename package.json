{
  "name": "@soprinter/sharenotejs",
  "version": "2.0.0",
  "description": "Reference JavaScript/TypeScript SDK for the Sharenote protocol",
  "license": "CC0-1.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/soprinter/sharenotejs"
  },
  "keywords": [
    "sharenote",
    "sharenotejs",
    "proof-of-work",
    "nostr",
    "cryptocurrency",
    "sdk"
  ],
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^1.6.1",
    "tsup": "^8.3.0",
    "typescript": "^5.7.3",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1"
  }
}
